    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction parseRevenue(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n\n  // Already numeric\n  if (typeof value === 'number') {\n    return value;\n  }\n\n  let text = String(value)\n    .trim()\n    .toLowerCase()\n    .replace(/,/g, '')\n    .replace(/\\$/g, '');\n\n  // Handle values such as:\n  // 50m\n  // 50 million\n  // 1.2b\n  // 750k\n  const match = text.match(/^([\\d.]+)\\s*(k|m|b|thousand|million|billion)?/);\n\n  if (!match) {\n    return null;\n  }\n\n  const number = parseFloat(match[1]);\n  const unit = match[2];\n\n  if (Number.isNaN(number)) {\n    return null;\n  }\n\n  switch (unit) {\n    case 'k':\n    case 'thousand':\n      return number * 1000;\n\n    case 'm':\n    case 'million':\n      return number * 1000000;\n\n    case 'b':\n    case 'billion':\n      return number * 1000000000;\n\n    default:\n      return number;\n  }\n}\n\nfunction parseEmployeeRange(value) {\n  if (value === null || value === undefined || value === '') {\n    return {\n      employee_min: null,\n      employee_max: null\n    };\n  }\n\n  const text = String(value).trim().toLowerCase();\n\n  // Example: \"100-500\"\n  const range = text.match(/(\\d+)\\s*-\\s*(\\d+)/);\n\n  if (range) {\n    return {\n      employee_min: Number(range[1]),\n      employee_max: Number(range[2])\n    };\n  }\n\n  // Example: \"500+\"\n  const plus = text.match(/(\\d+)\\+/);\n\n  if (plus) {\n    return {\n      employee_min: Number(plus[1]),\n      employee_max: null\n    };\n  }\n\n  // Example: \"250\"\n  const single = text.match(/^\\d+$/);\n\n  if (single) {\n    const number = Number(single[0]);\n\n    return {\n      employee_min: number,\n      employee_max: number\n    };\n  }\n\n  return {\n    employee_min: null,\n    employee_max: null\n  };\n}\n\nreturn items.map(item => {\n  const properties = item.json.properties || {};\n\n  const annualRevenue = properties.annualrevenue;\n  const employeeCount = properties.numemployees;\n\n  const employeeRange = parseEmployeeRange(employeeCount);\n\n  return {\n    json: {\n      ...item.json,\n\n      normalized: {\n        annualrevenue_numeric: parseRevenue(annualRevenue),\n        employee_min: employeeRange.employee_min,\n        employee_max: employeeRange.employee_max\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
