      "parameters": {
        "jsCode": "const revenue = $json.normalized?.annualrevenue_numeric || 0;\nconst employeeMin = $json.normalized?.employee_min || 0;\n\nlet segment;\nlet ownerId;\n\nif (revenue >= 100000000 || employeeMin >= 1000) {\n  segment = \"Enterprise\";\n  ownerId = \"94093807\";\n} else if (revenue >= 25000000 || employeeMin >= 100) {\n  segment = \"Mid-Market\";\n  ownerId = \"96695984\";\n} else {\n  segment = \"Commercial\";\n  ownerId = \"36925333\";\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      sales_segment: segment,\n      assigned_owner_id: ownerId\n    }\n  }\n];"
